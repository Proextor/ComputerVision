# Public build-time configuration only. These are non-routable placeholders.
# For same-origin serving, omit both URL variables from .env.local.
VITE_VISION_HTTP_URL=https://vision.example.invalid
VITE_VISION_WS_URL=wss://vision.example.invalid/api/v1/scene/stream
VITE_STALE_SECONDS=3
VITE_MIRROR_X=false
VITE_DEMO=false
VITE_CAPTURE_WIDTH=640
VITE_CAPTURE_HEIGHT=360
# Never place an ingest token, password, API key, or other secret in VITE_*.
